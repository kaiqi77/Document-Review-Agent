# OpenAI-compatible large language model endpoint
# Example: https://api.openai.com/v1, https://dashscope.aliyuncs.com/compatible-mode/v1, https://api.deepseek.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=gpt-4o-mini

# Local RAG API server port
RAG_PORT=3001
